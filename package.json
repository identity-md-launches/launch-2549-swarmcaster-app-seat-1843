{
  "name": "genkiai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The static GenkiAI website for IMD seat 1843.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-export.ts",
